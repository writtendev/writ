{
  "schemas": [
    {
      "object_id": "sch-widget",
      "ops": [
        { "op_type": "create", "body": { "namespace": "acme" } },
        { "op_type": "define-type", "body": { "type": "acme.widget" } },
        { "op_type": "define-op", "body": { "type": "acme.widget", "op_type": "review", "op_version": "1" } },
        { "op_type": "define-op", "body": { "type": "acme.widget", "op_type": "approve", "op_version": "1" } },
        {
          "op_type": "define-field",
          "body": {
            "type": "acme.widget",
            "op_type": "review",
            "op_version": "1",
            "field": "verdict",
            "target": "review_verdict",
            "value_type": "string",
            "strategy": "keyed-lww",
            "key": ["subject"],
            "key_types": { "subject": "person-ref" }
          }
        },
        {
          "op_type": "define-field",
          "body": {
            "type": "acme.widget",
            "op_type": "approve",
            "op_version": "1",
            "field": "verdict",
            "target": "approve_verdict",
            "value_type": "string",
            "strategy": "lww"
          }
        }
      ]
    }
  ],
  "envelope": {
    "object_id": "widget-1",
    "object_type": "acme.widget",
    "op_type": "approve",
    "op_version": 1,
    "body": { "verdict": "approve" }
  }
}
