{
  "name": "schema-concurrent-define-field",
  "description": "Two concurrent define-field ops both writing the field_value_type register at the same (type, op_type, op_version, field) key resolve exactly as any other keyed-lww register does: the fold's total order, not arrival order, decides the winner.",
  "object_id": "obj-schema-1",
  "fields": {
    "field_value_type": { "strategy": "keyed-lww", "op_type": "define-field", "field": "value_type", "key": ["type", "op_type", "op_version", "field"], "target": "field_value_type" }
  },
  "ops": [
    {
      "id": "op-root",
      "parents": [],
      "time": 100,
      "object_id": "obj-schema-1",
      "object_type": "schema",
      "op_type": "define-field",
      "op_version": 1,
      "body": { "type": "standup", "op_type": "create", "op_version": "1", "field": "summary", "value_type": "string" }
    },
    {
      "id": "op-b-earlier-tstar",
      "parents": ["op-root"],
      "time": 150,
      "object_id": "obj-schema-1",
      "object_type": "schema",
      "op_type": "define-field",
      "op_version": 1,
      "body": { "type": "standup", "op_type": "create", "op_version": "1", "field": "summary", "value_type": "enum" }
    },
    {
      "id": "op-a-later-tstar",
      "parents": ["op-root"],
      "time": 200,
      "object_id": "obj-schema-1",
      "object_type": "schema",
      "op_type": "define-field",
      "op_version": 1,
      "body": { "type": "standup", "op_type": "create", "op_version": "1", "field": "summary", "value_type": "text" }
    }
  ],
  "expected_state": {
    "field_value_type": [{ "key": ["standup", "create", "1", "summary"], "value": "text" }]
  }
}
