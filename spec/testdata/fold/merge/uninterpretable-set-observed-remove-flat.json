{
  "name": "uninterpretable-set-observed-remove-flat",
  "description": "The same rule on the flat body shape (§5.4), where `add` and `remove` are themselves the declared fields rather than members of an object under one. A side holds a string or an array of strings: a bare string is one item, and a side that is present and holds null is a write claimed with no value in it and is rejected. Remove-only operations apply removals to additions carried by causally preceding operations",
  "object_id": "obj-1",
  "fields": {
    "add": { "strategy": "set-observed-remove" }
  },
  "ops": [
    {
      "id": "op-a-good",
      "parents": [],
      "time": 100,
      "object_id": "obj-1",
      "body": {
        "add": ["urgent", "triage"]
      }
    },
    {
      "id": "op-b-scalar-side",
      "parents": ["op-a-good"],
      "time": 200,
      "object_id": "obj-1",
      "body": {
        "add": "solo"
      }
    },
    {
      "id": "op-c-number-item",
      "parents": ["op-b-scalar-side"],
      "time": 300,
      "object_id": "obj-1",
      "body": {
        "add": [5]
      }
    },
    {
      "id": "op-d-null-side",
      "parents": ["op-c-number-item"],
      "time": 400,
      "object_id": "obj-1",
      "body": {
        "add": null
      }
    },
    {
      "id": "op-e-null-item",
      "parents": ["op-d-null-side"],
      "time": 500,
      "object_id": "obj-1",
      "body": {
        "add": ["fine", null]
      }
    },
    {
      "id": "op-f-bad-remove",
      "parents": ["op-e-null-item"],
      "time": 600,
      "object_id": "obj-1",
      "body": {
        "add": ["never"],
        "remove": ["triage", 7]
      }
    },
    {
      "id": "op-g-good-remove",
      "parents": ["op-f-bad-remove"],
      "time": 700,
      "object_id": "obj-1",
      "body": {
        "add": ["kept"],
        "remove": ["urgent"]
      }
    },
    {
      "id": "op-h-remove-only",
      "parents": ["op-g-good-remove"],
      "time": 800,
      "object_id": "obj-1",
      "body": {
        "remove": ["solo"]
      }
    }
  ],
  "expected_state": {
    "add": ["kept", "triage"]
  },
  "expected_unknown_ops": [
    "op-c-number-item",
    "op-d-null-side",
    "op-e-null-item",
    "op-f-bad-remove"
  ]
}
