{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/spec/review-ops.schema.json",
  "title": "Writ review operations (v1)",
  "description": "JSON Schema for operations on collaborative objects of type 'review'. Extends the op envelope schema (spec/schemas/op-envelope.schema.json) with body definitions for create, revision, update, set-status, approval, ci-status, assign, label, and link. Unknown additional properties are permitted on envelope and body per the forward compatibility rule.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://writ.dev/spec/op-envelope.schema.json"
    }
  ],
  "properties": {
    "object_type": {
      "const": "review"
    }
  },
  "required": [
    "object_type"
  ],
  "if": {
    "properties": {
      "object_type": {
        "const": "review"
      },
      "op_version": {
        "const": 1
      }
    },
    "required": [
      "object_type",
      "op_version"
    ]
  },
  "then": {
    "allOf": [
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "create"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/create_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "revision"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/revision_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "update"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/update_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "set-status"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/set_status_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "approval"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/approval_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "ci-status"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/ci_status_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "assign"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/assign_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "label"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/label_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "link"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/link_body"
            }
          }
        }
      }
    ]
  },
  "$defs": {
    "oid": {
      "$ref": "https://writ.dev/spec/value-types.schema.json#/$defs/git-oid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "create_body": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ]
    },
    "revision_body": {
      "type": "object",
      "properties": {
        "base": {
          "$ref": "#/$defs/oid"
        },
        "head": {
          "$ref": "#/$defs/oid"
        }
      },
      "required": [
        "base",
        "head"
      ]
    },
    "update_body": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "description"
          ]
        }
      ]
    },
    "set_status_body": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "open",
            "closed",
            "merged"
          ]
        },
        "merge_commit": {
          "$ref": "#/$defs/oid"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ]
    },
    "approval_body": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/oid"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "approve",
            "request-changes",
            "none"
          ]
        },
        "subject": {
          "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/person-id"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "revision",
        "verdict"
      ]
    },
    "ci_status_body": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/oid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "success",
            "failure",
            "error",
            "cancelled",
            "neutral",
            "skipped"
          ]
        },
        "url": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "external_id": {
          "type": "string"
        }
      },
      "required": [
        "revision",
        "name",
        "state"
      ]
    },
    "assign_body": {
      "type": "object",
      "properties": {
        "add": {
          "type": "array",
          "items": {
            "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/person-id"
          },
          "minItems": 1
        },
        "remove": {
          "type": "array",
          "items": {
            "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/person-id"
          },
          "minItems": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "add"
          ]
        },
        {
          "required": [
            "remove"
          ]
        }
      ]
    },
    "label_body": {
      "type": "object",
      "properties": {
        "add": {
          "type": "array",
          "items": {
            "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/reference"
          },
          "minItems": 1
        },
        "remove": {
          "type": "array",
          "items": {
            "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/reference"
          },
          "minItems": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "add"
          ]
        },
        {
          "required": [
            "remove"
          ]
        }
      ]
    },
    "link_body": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/reference"
        },
        "target_type": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "enum": [
            "fixes",
            "relates",
            "none"
          ]
        }
      },
      "required": [
        "target",
        "relation"
      ]
    }
  }
}
