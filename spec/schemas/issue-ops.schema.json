{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writ.dev/spec/issue-ops.schema.json",
  "title": "Writ issue operations (v1)",
  "description": "JSON Schema for operations on collaborative objects of type 'issue'. Extends the op envelope schema (spec/schemas/op-envelope.schema.json) with body definitions for create, update, set-state, assign, label, and link. Unknown additional properties are permitted on envelope and body per the forward compatibility rule.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://writ.dev/spec/op-envelope.schema.json"
    }
  ],
  "properties": {
    "object_type": {
      "const": "issue"
    }
  },
  "required": [
    "object_type"
  ],
  "if": {
    "properties": {
      "object_type": {
        "const": "issue"
      },
      "op_version": {
        "const": 1
      }
    },
    "required": [
      "object_type",
      "op_version"
    ]
  },
  "then": {
    "allOf": [
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "create"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/create_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "update"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/update_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "set-state"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/set_state_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "assign"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/assign_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "label"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/label_body"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "op_type": {
              "const": "link"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/link_body"
            }
          }
        }
      }
    ]
  },
  "$defs": {
    "create_body": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "estimate": {
          "type": "number",
          "minimum": 0
        },
        "position": {
          "$ref": "https://writ.dev/spec/ordering.schema.json#/$defs/position"
        }
      },
      "required": [
        "title"
      ]
    },
    "update_body": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "estimate": {
          "type": "number",
          "minimum": 0
        },
        "position": {
          "$ref": "https://writ.dev/spec/ordering.schema.json#/$defs/position"
        }
      },
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "description"
          ]
        },
        {
          "required": [
            "priority"
          ]
        },
        {
          "required": [
            "estimate"
          ]
        },
        {
          "required": [
            "position"
          ]
        }
      ]
    },
    "set_state_body": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/reference"
        },
        "reason": {
          "type": "string"
        },
        "position": {
          "$ref": "https://writ.dev/spec/ordering.schema.json#/$defs/position"
        }
      },
      "required": [
        "state"
      ]
    },
    "assign_body": {
      "type": "object",
      "properties": {
        "add": {
          "type": "array",
          "items": {
            "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/person-id"
          },
          "minItems": 1
        },
        "remove": {
          "type": "array",
          "items": {
            "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/person-id"
          },
          "minItems": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "add"
          ]
        },
        {
          "required": [
            "remove"
          ]
        }
      ]
    },
    "label_body": {
      "type": "object",
      "properties": {
        "add": {
          "type": "array",
          "items": {
            "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/reference"
          },
          "minItems": 1
        },
        "remove": {
          "type": "array",
          "items": {
            "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/reference"
          },
          "minItems": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "add"
          ]
        },
        {
          "required": [
            "remove"
          ]
        }
      ]
    },
    "link_body": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "https://writ.dev/spec/identifiers.schema.json#/$defs/reference"
        },
        "target_type": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "enum": [
            "fixes",
            "relates",
            "none"
          ]
        }
      },
      "required": [
        "target",
        "relation"
      ]
    }
  }
}
